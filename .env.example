# Copy to .env.local and fill in real values (never commit .env.local).
# Production: set the same variables in Netlify → Site settings → Environment variables.

# Supabase — dashboard → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session cookie signing secret (any long random string)
SESSION_SECRET=

# Super-admin login
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Email — option A: SMTP (preferred when set; e.g. Gmail + app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Email — option B: Resend API (used only when SMTP_USER/SMTP_PASS unset)
RESEND_API_KEY=
# Sender shown on outgoing mail — must match the SMTP account (or a verified alias/domain)
EMAIL_FROM="Rotaract District 3233 <you@yourdomain.org>"

# Public URL of the deployed app (used in email links)
NEXT_PUBLIC_APP_URL=

# Shared secret protecting /api/cron/event-reminders (generate: openssl rand -hex 24)
CRON_SECRET=
