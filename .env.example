# Copy to .env.local and fill in real values (never commit .env.local).
# Production: set the same variables in Netlify → Site settings → Environment variables.

# Supabase — dashboard → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session cookie signing secret (any long random string)
SESSION_SECRET=

# Super-admin login
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Email (Resend) — dashboard → API keys; EMAIL_FROM must use a verified domain
RESEND_API_KEY=
EMAIL_FROM="VIBE District 3233 <no-reply@yourdomain.org>"

# Public URL of the deployed app (used in email links)
NEXT_PUBLIC_APP_URL=

# Shared secret protecting /api/cron/event-reminders (generate: openssl rand -hex 24)
CRON_SECRET=
